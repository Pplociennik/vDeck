%% Diagram klas: feature authentication oraz współpracujące komponenty bezpieczeństwa
classDiagram
    direction TB

    class PanelUser {
        -String username
        -String passwordHash
        -PanelRole role
        -boolean passwordChangeRequired
        +getUsername() String
        +getPasswordHash() String
        +getRole() PanelRole
        +isPasswordChangeRequired() boolean
        +changePassword(String newPasswordHash) void
    }

    class PanelRole {
        <<enumeration>>
        ADMIN
    }

    class PasswordChangeException {
        -PasswordChangeMessage messageKey
        +getMessageKey() PasswordChangeMessage
    }

    class PasswordChangeExceptionHandler {
        <<ControllerAdvice>>
        +handleRejectedChange(PasswordChangeException, HttpServletRequest, RedirectAttributes) String
    }

    class PasswordChangeMessage {
        <<enumeration>>
        INVALID_INPUT
        CURRENT_PASSWORD_INCORRECT
        NEW_PASSWORD_MISMATCH
        NEW_PASSWORD_UNCHANGED
        NEW_PASSWORD_TOO_WEAK
        +getKey() String
    }

    class TranslationKeyIf {
        <<interface>>
        +getKey() String
    }

    class PasswordChangeRequest {
        <<record>>
        +currentPassword() String
        +newPassword() String
        +confirmation() String
        +toString() String
    }

    class InitialPasswordChangeRequest {
        <<record>>
        +newPassword() String
        +confirmation() String
        +toString() String
    }

    class UserRepository {
        <<interface>>
        +findById(String) Optional
        +existsById(String) boolean
        +save(PanelUser) PanelUser
    }

    class UserDetailsService {
        <<interface>>
        +loadUserByUsername(String) UserDetails
    }

    class PanelUserService {
        <<interface>>
        +PASSWORD_CHANGE_REQUIRED_AUTHORITY String
        +changePassword(String, PasswordChangeRequest) void
        +changeInitialPassword(String, InitialPasswordChangeRequest) void
    }

    class PanelUserServiceImpl {
        -UserRepository userRepository
        -PasswordEncoder passwordEncoder
        +loadUserByUsername(String) UserDetails
        +changePassword(String, PasswordChangeRequest) void
        +changeInitialPassword(String, InitialPasswordChangeRequest) void
        -applyNewPassword(PanelUser, String, String) void
        -toUserDetails(PanelUser) UserDetails
    }

    class PasswordChangeController {
        -PanelUserService panelUserService
        -SecurityContextLogoutHandler logoutHandler
        +showPasswordChange(Model) String
        +changePassword(...) String
    }

    class InitialPasswordChangeController {
        -PanelUserService panelUserService
        -SecurityContextLogoutHandler logoutHandler
        +showInitialPasswordChange(Model) String
        +changeInitialPassword(...) String
    }

    class PasswordChangeAuthenticationSuccessHandler {
        -AuthenticationSuccessHandler defaultSuccessHandler
        +onAuthenticationSuccess(...) void
    }

    class PasswordChangeRequiredFilter {
        -ALLOWED_PATHS Set
        #doFilterInternal(...) void
    }

    class SecurityConfiguration {
        +passwordEncoder() PasswordEncoder
        +securityFilterChain(...) SecurityFilterChain
        +passwordChangeRequiredFilter() PasswordChangeRequiredFilter
        +authenticationSuccessHandler() PasswordChangeAuthenticationSuccessHandler
        +httpSessionEventPublisher() HttpSessionEventPublisher
    }

    class DataInitializer {
        -UserRepository userRepository
        -PasswordEncoder passwordEncoder
        +run(String...) void
    }

    UserDetailsService <|-- PanelUserService
    PanelUserService <|.. PanelUserServiceImpl
    TranslationKeyIf <|.. PasswordChangeMessage
    PanelUserServiceImpl --> UserRepository : używa
    PanelUserServiceImpl ..> PasswordChangeRequest : przyjmuje
    PanelUserServiceImpl ..> InitialPasswordChangeRequest : przyjmuje
    PanelUserServiceImpl ..> PasswordChangeException : rzuca przy odrzuceniu
    PasswordChangeException --> PasswordChangeMessage : niesie klucz
    PasswordChangeExceptionHandler ..> PasswordChangeException : obsługuje
    UserRepository ..> PanelUser : przechowuje
    PanelUser --> PanelRole : ma
    PasswordChangeController --> PanelUserService : deleguje
    InitialPasswordChangeController --> PanelUserService : deleguje
    PasswordChangeController ..> PasswordChangeException : rzuca przy błędzie adnotacji
    InitialPasswordChangeController ..> PasswordChangeException : rzuca przy błędzie adnotacji
    PasswordChangeAuthenticationSuccessHandler ..> PanelUserService : czyta uprawnienie
    PasswordChangeRequiredFilter ..> PanelUserService : czyta uprawnienie
    SecurityConfiguration ..> PasswordChangeRequiredFilter : tworzy
    SecurityConfiguration ..> PasswordChangeAuthenticationSuccessHandler : tworzy
    DataInitializer --> UserRepository : tworzy konto domyślne
