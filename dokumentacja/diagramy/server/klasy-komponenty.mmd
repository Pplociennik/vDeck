%% Diagram klas: komponenty uruchamiania serwera
classDiagram
    direction TB
    namespace vdeck_app {
        class ServerController
        class ServerExceptionHandler
        class ServerStatusAdvice
        class ServerStateController
        class ServerService {
            <<interface>>
            start()
            stop(launchId)
            restart(launchId)
            kill(launchId, confirmed)
            adopt(launchId)
            getStatus()
        }
        class ServerServiceImpl
        class ServerStartValidator
        class LaunchProfileService {
            <<interface>>
        }
        class LaunchCommandService {
            <<interface>>
        }
        class ServerLogService {
            <<interface>>
        }
        class LaunchConfiguration
        class BackupPathService {
            <<interface>>
        }
        class ServerShutdownCoordinator {
            closeServer() @PreDestroy
        }
        class PanelCloseStrategy {
            <<interface>>
            getMode()
            apply()
        }
        class StopPanelCloseStrategy
        class GracefulPanelCloseStrategy
        class LeavePanelCloseStrategy
        class ConsoleControlConfiguration
        class ServerRuntimeConfiguration
    }
    namespace vdeck_runner {
        class VdeckRunner
    }
    namespace vdeck_runtime {
        class ServerRuntime {
            <<interface>>
            start(LaunchSpec, WorldContext)
            stop(StopRequest)
            shutdown()
            adopt(launchId)
            status()
        }
        class ServerStateMachine
        class LaunchSpec
        class ServerStatus
        class GameProcessLauncher {
            <<interface>>
        }
        class WindowsProcessLauncher
        class Win32
        class WorldContext
        class FileWorldSnapshotStore
        class FileIdentityReader {
            <<interface>>
        }
        class WindowsFileIdentityReader
        class JvmConsoleControlSender
        class ConsoleControlSender {
            <<interface>>
        }
        class WindowsConsoleControlSender
        class ManagedLaunchStore
    }
    ServerController --> ServerService : akcje launchId
    ServerExceptionHandler ..> ServerController : obsługa błędu
    ServerStatusAdvice --> ServerService : stan widoku
    ServerStateController ..> ServerStatusAdvice : migawka z modelu
    ServerStateController --> LaunchProfileService : profil bez sekretów
    ServerServiceImpl ..|> ServerService
    ServerServiceImpl --> ServerStartValidator : walidacja
    ServerServiceImpl --> LaunchProfileService : gotowa konfiguracja
    ServerServiceImpl --> LaunchCommandService : polecenie
    ServerServiceImpl --> ServerLogService : log
    LaunchProfileService ..> LaunchConfiguration : publikuje po zapisie
    ServerStartValidator ..> LaunchConfiguration : waliduje
    LaunchCommandService ..> LaunchConfiguration : odczytuje
    LaunchCommandService ..> LaunchSpec : tworzy i renderuje skrypt
    ServerServiceImpl --> ServerRuntime : granica modułów
    ServerStateMachine ..|> ServerRuntime
    ServerRuntime ..> ServerStatus : publikuje
    ServerStateMachine --> GameProcessLauncher : uruchamia
    WindowsProcessLauncher ..|> GameProcessLauncher
    WindowsProcessLauncher --> Win32 : wstrzykiwana granica Windows
    ServerServiceImpl --> BackupPathService : root poza instalacją
    ServerServiceImpl ..> WorldContext : przechwytuje przy starcie
    ServerStateMachine --> FileWorldSnapshotStore : worker snapshotu
    FileWorldSnapshotStore --> FileIdentityReader : tożsamość plików
    WindowsFileIdentityReader ..|> FileIdentityReader
    WindowsFileIdentityReader --> Win32 : FileIdInfo
    ConsoleControlConfiguration ..> JvmConsoleControlSender : tworzy bezczynny bean
    ServerRuntimeConfiguration ..> ConsoleControlSender : wstrzykuje do runtime
    ServerStateMachine --> ConsoleControlSender : żądanie sygnału na workerze
    JvmConsoleControlSender ..|> ConsoleControlSender
    ServerStateMachine --> ManagedLaunchStore : token i FileLock
    ServerShutdownCoordinator --> PanelCloseStrategy : wybór wg panel.close.strategy
    StopPanelCloseStrategy ..|> PanelCloseStrategy
    GracefulPanelCloseStrategy ..|> PanelCloseStrategy
    LeavePanelCloseStrategy ..|> PanelCloseStrategy
    StopPanelCloseStrategy --> ServerRuntime : shutdown, potem shutdownKill
    GracefulPanelCloseStrategy --> ServerRuntime : shutdown przed close
    JvmConsoleControlSender ..> VdeckRunner : uruchomienie JAR na żądanie
    VdeckRunner --> WindowsConsoleControlSender : osobna JVM
    WindowsConsoleControlSender --> Win32 : izolowane CTRL+C
