%% Diagram klas: infrastruktura konfiguracji i rozwiązywania ścieżek
classDiagram
    direction TB

    class SystemPropertyIf {
        <<interface>>
        +getName() String
        +isMandatory() boolean
    }

    class VdeckProperty {
        <<enumeration>>
        GAME_LOG_DIRECTORY
        GAME_SETTINGS_ADVANCED
        +FILE_NAME String
        +defaults() SystemPropertyValues
        +getName() String
        +isMandatory() boolean
        +getDefaultValue() String
    }

    class LaunchProperty {
        <<enumeration>>
        SERVER_NAME … WORLD_KEY_NO_MAP
        +FILE_NAME String
        +defaults() SystemPropertyValues
        +getName() String
        +isMandatory() boolean
        +getDefaultValue() String
    }

    class SystemPropertyValues {
        -Map values
        +create()$ SystemPropertyValues
        +with(SystemPropertyIf, String) SystemPropertyValues
        +asMap() Map
    }

    class PropertyReader {
        <<utility>>
        +read(SystemPropertiesService, String, SystemPropertyIf)$ String
        +readInt(SystemPropertiesService, String, SystemPropertyIf, String)$ int
        +readBoolean(SystemPropertiesService, String, SystemPropertyIf, String)$ boolean
        +readOptional(SystemPropertiesService, String, SystemPropertyIf, Function)$ Optional
    }

    class SystemPropertiesService {
        <<interface>>
        +loadFile(String, SystemPropertyValues) void
        +getValue(String, SystemPropertyIf) String
        +setValue(String, SystemPropertyIf, String) void
        +setValues(String, SystemPropertyValues) void
    }

    class SystemPropertiesServiceImpl {
        <<Service>>
        -PathService pathService
        -Map files
        -requireLoaded(String) PropertiesFile
    }

    class PropertiesFile {
        -Path propertiesFile
        -Map defaults
        -Properties properties
        ~getValue(SystemPropertyIf) String
        ~setValue(SystemPropertyIf, String) void
        ~setValues(SystemPropertyValues) void
        -loadOrCreate() void
        -createParentDirectories() void
        -read() void
        -restoreMissingValues() boolean
        -applyAndSave(Map) void
        -save() void
    }

    class PathService {
        <<interface>>
        +CONFIGURATION_DIRECTORY String
        +getBaseDirectory() Path
        +getAbsolutePath(String) Path
        +getConfigurationFile(String) Path
    }

    class PathServiceImpl {
        -ApplicationHome applicationHome
        -Path baseDirectory
        -resolveBaseDirectory(String) Path
        -requireInsideBaseDirectory(Path, String) void
    }

    class PathResolutionException {
        <<exception>>
    }

    class PathConfiguration {
        +pathService(String) PathService
    }

    class SystemPropertiesInitializer {
        <<SmartInitializingSingleton>>
        +afterSingletonsInstantiated() void
    }

    SystemPropertyIf <|.. VdeckProperty
    SystemPropertyIf <|.. LaunchProperty
    SystemPropertiesService <|.. SystemPropertiesServiceImpl
    SystemPropertiesServiceImpl *-- PropertiesFile : jeden na wczytany plik
    SystemPropertiesServiceImpl --> PathService : plik w .vDeck/config
    PropertiesFile ..> SystemPropertyIf : klucze i obowiązkowość ustawień
    SystemPropertyValues o-- SystemPropertyIf : wartość na ustawienie
    SystemPropertiesService ..> SystemPropertyValues : wartości domyślne i zapis zbiorczy
    PropertyReader ..> SystemPropertiesService : getValue i wartość zastępcza
    PathService <|.. PathServiceImpl
    PathServiceImpl ..> PathResolutionException : zgłasza
    PathConfiguration ..> PathServiceImpl : tworzy
    SystemPropertiesInitializer --> SystemPropertiesService : loadFile przy starcie
    SystemPropertiesInitializer ..> VdeckProperty : FILE_NAME i wartości domyślne
    SystemPropertiesInitializer ..> LaunchProperty : FILE_NAME i wartości domyślne