%% Diagram przepływu: start aplikacji vDeck i przygotowanie środowiska
flowchart TD
    bat([start-vDeck.bat]) --> files{Dołączone JRE<br/>i oba JAR-y obecne?}
    files -- nie --> missing([Komunikat i kod 1])
    files -- tak --> bundled[jre/bin/java.exe<br/>Katalog roboczy = instalacja<br/>Dostęp natywny, adres 127.0.0.1]
    bundled --> start([Uruchomienie VdeckApplication])
    start --> spring[SpringApplication.run]
    spring --> home{Ustawiono<br/>vdeck.server-directory?}
    home -- tak --> configured[Katalog bazowy = wartość override]
    home -- nie --> appHome[Katalog bazowy = ApplicationHome.getDir]
    configured --> real[PathServiceImpl: toRealPath i sprawdzenie,<br/>czy to katalog]
    appHome --> real
    real -- nie jest katalogiem --> fail([PathResolutionException:<br/>start przerwany])
    real -- ok --> sender[ConsoleControlConfiguration:<br/>bean ConsoleControlSender z poleceniem runnera<br/>Bez procesu i wątku oczekującego]
    sender --> lock{FileLock .vDeck/vdeck.lock<br/>zdobyty?}
    lock -- nie --> lockFail([Drugi panel: start przerwany])
    lock -- tak --> recovery[Walidacja tokenu i skan procesu<br/>STOPPED albo RECOVERY_REQUIRED]
    recovery --> schema[Hibernate ddl-auto=update:<br/>utworzenie lub aktualizacja tabeli panel_users]
    schema --> props[SystemPropertiesInitializer: loadFile dla każdego pliku ustawień<br/>vDeck.properties, valheim-server.properties<br/>PathService.getConfigurationFile → .vDeck/config/plik]
    props --> exists{Plik ustawień<br/>istnieje?}
    exists -- nie --> create[Utworzenie katalogu .vDeck/config<br/>i zapis pliku z wartościami domyślnymi enuma]
    exists -- tak --> read[Wczytanie pliku i przycięcie wartości]
    read -- błąd odczytu --> readFail([UncheckedIOException:<br/>start przerwany])
    read --> missing{Brakuje klucza albo ustawienie<br/>obowiązkowe jest puste?}
    missing -- tak --> restore[Przywrócenie wartości domyślnych<br/>i zapis pliku]
    missing -- nie --> ready[Ustawienia gotowe w pamięci]
    create --> ready
    restore --> ready
    ready --> profile[LaunchProfileService.reload:<br/>publikacja LaunchConfiguration z profilu i hasła]
    profile --> init[DataInitializer.run]
    init --> adminExists{Konto 'admin'<br/>istnieje?}
    adminExists -- tak --> skip[Pominięcie inicjalizacji]
    adminExists -- nie --> createAdmin[Zapis PanelUser 'admin'<br/>z zahaszowanym hasłem 'admin'<br/>i passwordChangeRequired = true]
    skip --> up([Panel nasłuchuje na 127.0.0.1])
    createAdmin --> up
