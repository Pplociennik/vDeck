<?xml version="1.0" encoding="UTF-8"?>
<!-- Applied by Spring Boot at panel startup. One file per vDeck version, included in release order. -->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <include file="versions/0.0.1.xml" relativeToChangelogFile="true"/>
    <include file="versions/0.1.0.xml" relativeToChangelogFile="true"/>

</databaseChangeLog>
