<?xml version="1.0" encoding="UTF-8"?>
<!-- Each run writes its own file chosen by the bootstrap class (vdeck.log.file). Technical English entries
     go to the file at DEBUG; Polish messages of the vdeck.console logger also reach the console. -->
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%m%n" charset="${sys:stdout.encoding:-UTF-8}"/>
        </Console>
        <!-- A run larger than 10 MiB rolls over once, so one run never keeps more than two files. -->
        <RollingFile name="RunLog" fileName="${sys:vdeck.log.file}" filePattern="${sys:vdeck.log.file}.%i">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%t] %c{1} - %m%n" charset="UTF-8"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="10 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="1"/>
        </RollingFile>
    </Appenders>
    <Loggers>
        <Logger name="vdeck.console" level="info">
            <AppenderRef ref="Console"/>
        </Logger>
        <Root level="debug">
            <AppenderRef ref="RunLog"/>
        </Root>
    </Loggers>
</Configuration>
